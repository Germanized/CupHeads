<?xml version="1.0" encoding="utf-8"?>
<!--
  The mod references BepInEx/Harmony/Unity straight from the game install, so the
  only package restore needs is the net35 reference assemblies from nuget.org.
  Clearing inherited sources keeps an unreachable machine-wide feed (e.g. the
  BepInEx feed) from failing every build.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
